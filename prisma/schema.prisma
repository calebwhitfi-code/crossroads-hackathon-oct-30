generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum SubmissionStatus {
  pending_review
  approved
}

enum AssignmentCategory {
  test
  quiz
  homework
}

enum SubmissionSource {
  manual
  vision
}

model Family {
  id        String    @id @default(cuid())
  name      String
  students  Student[]
  rubrics   Rubric[]
  createdAt DateTime  @default(now())
}

model Student {
  id             String   @id @default(cuid())
  familyId       String
  family         Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  gradeLevel     Int
  graduationYear Int
  courses        Course[]
  createdAt      DateTime @default(now())

  @@index([familyId])
}

model Course {
  id           String       @id @default(cuid())
  studentId    String
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name         String
  subject      String
  curriculum   String?
  credits      Float
  weighted     Boolean      @default(false)
  gradeLevel   Int
  academicYear String
  completed    Boolean      @default(false)
  version      Int          @default(0)
  assignments  Assignment[]
  createdAt    DateTime     @default(now())

  @@index([studentId, academicYear])
}

model Assignment {
  id          String       @id @default(cuid())
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  maxPoints   Float        @default(100)
  category    AssignmentCategory @default(homework)
  dueAt       DateTime?
  version     Int          @default(0)
  rubricId    String?
  rubric      Rubric?      @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  submissions Submission[]
  createdAt   DateTime     @default(now())

  @@index([courseId, dueAt])
  @@index([rubricId])
}

model Rubric {
  id          String            @id @default(cuid())
  familyId    String?
  family      Family?           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name        String
  description String
  isTemplate  Boolean           @default(false)
  criteria    RubricCriterion[]
  assignments Assignment[]
  createdAt   DateTime          @default(now())

  @@index([familyId])
}

model RubricCriterion {
  id          String           @id @default(cuid())
  rubricId    String
  rubric      Rubric           @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  name        String
  description String
  maxPoints   Float
  position    Int
  scores      CriterionScore[]

  @@unique([rubricId, position])
}

model Submission {
  id             String           @id @default(cuid())
  assignmentId   String
  assignment     Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  source         SubmissionSource @default(manual)
  image          String?
  extractedText  String?
  feedback       String
  suggestedGrade String?
  letterGrade    String?
  earnedPoints   Float?
  status         SubmissionStatus @default(pending_review)
  approvedAt     DateTime?
  criteriaScores CriterionScore[]
  createdAt      DateTime         @default(now())

  @@index([assignmentId, status])
}

model CriterionScore {
  id           String          @id @default(cuid())
  submissionId String
  submission   Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  criterionId  String
  criterion    RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)
  earnedPoints Float
  feedback     String
  name         String
  description  String
  maxPoints    Float

  @@unique([submissionId, criterionId])
  @@index([criterionId])
}
